#!/bin/sh /etc/rc.common
# roam-steer 服务：每 30 秒检查一次弱信号客户端，必要时用 11v 引导切换
USE_PROCD=1
START=99
STOP=01

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c 'while true; do /usr/sbin/roam-steer; sleep 30; done'
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
