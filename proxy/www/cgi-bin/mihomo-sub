#!/bin/sh
# mihomo 订阅管理 CGI
#   GET              -> 订阅列表 JSON [{name,url,enabled}]
#   GET ?info=1      -> 面板连接信息 {backend,secret}
#   GET ?mode=1      -> 当前全局模式 {mode,groups}
#   POST action=add&name=&url=
#   POST action=del&name=
#   POST action=toggle&name=                     启用/停用
#   POST action=mode&v=Auto|DIRECT|<组名>        切换全局出口
#   POST action=secret&url=<新密钥>
#   GET ?delay=1     -> 所有节点延迟 {node:ms}
#   GET ?speed=1[&node=<节点>][&bytes=N] -> 下载测速
SUBS=/etc/mihomo/subs.list
GEN=/etc/mihomo/gen-config.sh
API=http://127.0.0.1:9090
MAX_SUBS=10

[ -f "$SUBS" ] || : > "$SUBS"

urldecode() {
	printf '%b' "$(printf '%s' "$1" | sed -e 's/+/ /g' -e 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"
}
sanitize()   { printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_' | cut -c1-40; }
json_escape(){ printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
secret()     { cat /etc/mihomo/.secret 2>/dev/null; }
count_subs() { grep -c . "$SUBS" 2>/dev/null || echo 0; }

# 原子写入：先写临时文件，再改名；改前留一份 .bak
write_subs() {
	cat > "$SUBS.tmp" || return 1
	[ -s "$SUBS.tmp" ] || { rm -f "$SUBS.tmp"; return 1; }
	cp -f "$SUBS" "$SUBS.bak" 2>/dev/null
	# 保留最近 5 份带时间戳的快照，误删时可回滚
	cp -f "$SUBS" "$SUBS.bak.$(date +%Y%m%d-%H%M%S)" 2>/dev/null
	i=0
	for f in $(ls -1t "$SUBS".bak.* 2>/dev/null); do
		i=$((i+1))
		[ "$i" -gt 5 ] && rm -f "$f"
	done
	mv -f "$SUBS.tmp" "$SUBS"
}

echo "Content-Type: application/json; charset=utf-8"
echo "Cache-Control: no-store"
echo

api_put() { # $1=path $2=json
	curl -sS -m 15 -o /dev/null -w '%{http_code}' -X PUT \
		-H "Authorization: Bearer $(secret)" -H 'Content-Type: application/json' \
		-d "$2" "$API$1" 2>/dev/null
}

if [ "$REQUEST_METHOD" = "POST" ]; then
	LEN=${CONTENT_LENGTH:-0}
	[ "$LEN" -gt 8192 ] && LEN=8192
	BODY=$(dd bs=1 count="$LEN" 2>/dev/null)
	ACTION=""; NAME=""; URL=""; VAL=""
	for pair in $(printf '%s' "$BODY" | tr '&' '\n'); do
		k=${pair%%=*}; v=${pair#*=}
		case "$k" in
			action) ACTION=$(urldecode "$v") ;;
			name)   NAME=$(urldecode "$v") ;;
			url)    URL=$(urldecode "$v") ;;
			v)      VAL=$(urldecode "$v") ;;
		esac
	done

	case "$ACTION" in
	add)
		NAME=$(sanitize "$NAME")
		case "$URL" in
			http://*|https://*) ;;
			*) echo '{"ok":false,"msg":"订阅链接必须以 http:// 或 https:// 开头"}'; exit 0 ;;
		esac
		[ -z "$NAME" ] && { echo '{"ok":false,"msg":"名称不能为空"}'; exit 0; }
		grep -q "^$NAME|" "$SUBS" 2>/dev/null && { echo '{"ok":false,"msg":"同名订阅已存在，请换个名称"}'; exit 0; }
		cnt=$(count_subs)
		if [ "$cnt" -ge "$MAX_SUBS" ]; then
			echo "{\"ok\":false,\"msg\":\"最多支持 $MAX_SUBS 个订阅，已用 $cnt 个。请先删除不用的\"}"
			exit 0
		fi
		{ cat "$SUBS" 2>/dev/null; printf '%s|%s|1\n' "$NAME" "$URL"; } | write_subs || {
			echo '{"ok":false,"msg":"写入失败"}'; exit 0; }
		logger -t mihomo-ui "订阅已添加: $NAME（共 $(count_subs) 个）"
		;;
	del)
		NAME=$(sanitize "$NAME")
		grep -q "^$NAME|" "$SUBS" 2>/dev/null || { echo '{"ok":false,"msg":"订阅不存在"}'; exit 0; }
		grep -v "^$NAME|" "$SUBS" | write_subs || { echo '{"ok":false,"msg":"写入失败"}'; exit 0; }
		logger -t mihomo-ui "订阅已删除: $NAME（剩 $(count_subs) 个）"
		;;
	toggle)
		NAME=$(sanitize "$NAME")
		cur=$(awk -F'|' -v n="$NAME" '$1==n{print ($3==""?1:$3)}' "$SUBS")
		[ -z "$cur" ] && { echo '{"ok":false,"msg":"订阅不存在"}'; exit 0; }
		new=$((1-cur))
		awk -F'|' -v n="$NAME" -v v="$new" 'BEGIN{OFS="|"} $1==n{$3=v; print; next} NF==2{print $1,$2,1; next} {print}' "$SUBS" | write_subs || {
			echo '{"ok":false,"msg":"写入失败"}'; exit 0; }
		logger -t mihomo-ui "订阅$([ "$new" = "1" ] && echo 启用 || echo 停用): $NAME"
		;;
	proxy_set)
		case "$VAL" in
			on|off) ;;
			*) echo '{"ok":false,"msg":"非法参数"}'; exit 0 ;;
		esac
		# 捕获 mihomo-switch 输出与退出码：互斥拦截时退出码非 0，不能报"已开启"
		SWITCH_OUT=$(/usr/sbin/mihomo-switch "$VAL" 2>&1)
		SWITCH_RC=$?
		if [ "$SWITCH_RC" -ne 0 ]; then
			# 互斥拦截：对端代理已开，提示用户先关对端（不展开对端详情）
			echo '{"ok":false,"msg":"主代理未关闭，不允许开启"}'
			logger -t mihomo-ui "开启代理被互斥拦截：主代理未关闭，不允许开启"
			exit 0
		fi
		if [ "$VAL" = "on" ]; then
			echo '{"ok":true,"msg":"代理已开启"}'
		else
			echo '{"ok":true,"msg":"代理已关闭，DNS 已切回直连"}'
		fi
		exit 0
		;;
	adblock_toggle)
		cur=$(cat /etc/mihomo/adblock.enabled 2>/dev/null || echo 1)
		[ "$cur" = "1" ] && new=0 || new=1
		printf '%s\n' "$new" > /etc/mihomo/adblock.enabled
		logger -t mihomo-ui "广告拦截$([ "$new" = "1" ] && echo 开启 || echo 关闭)"
		;;
	adblock_update)
		if ps w 2>/dev/null | grep -q "[a]dblock-update"; then
			echo '{"ok":false,"msg":"已有更新任务在跑，请稍候"}'
			exit 0
		fi
		nohup sh -c '/usr/sbin/adblock-update >>/tmp/adblock-update.log 2>&1' </dev/null >/dev/null 2>&1 &
		logger -t mihomo-ui "手动触发广告规则更新"
		echo '{"ok":true,"msg":"已开始更新，约 10-30 秒后刷新查看结果"}'
		exit 0
		;;
	sub_update)
		# 手动更新单个订阅：强制拉取 provider 缓存 -> 重新生成配置 -> 重启 mihomo
		NAME=$(urldecode "$NAME")
		case "$NAME" in
			""|*'"'*|*\\*) echo '{"ok":false,"msg":"缺少订阅名"}'; exit 0 ;;
		esac
		grep -q "^$NAME|" "$SUBS" 2>/dev/null || { echo '{"ok":false,"msg":"订阅不存在"}'; exit 0; }
		LOCK=/tmp/mihomo-sub-update.lock
		mkdir "$LOCK" 2>/dev/null || { echo '{"ok":false,"msg":"已有订阅更新任务在跑，请稍候"}'; exit 0; }
		# 后台执行，不阻塞请求；完成后 rmdir 锁
		nohup sh -c '
			NAME="$1"
			SEC=$(cat /etc/mihomo/.secret 2>/dev/null)
			curl -sS -m 60 -X PUT -H "Authorization: Bearer $SEC" \
				"http://127.0.0.1:9090/providers/proxies/$NAME" >/dev/null 2>&1
			/etc/mihomo/gen-config.sh >/dev/null 2>&1
			/etc/init.d/mihomo restart
			rmdir /tmp/mihomo-sub-update.lock 2>/dev/null
		' sh "$NAME" </dev/null >/dev/null 2>&1 &
		logger -t mihomo-ui "手动更新订阅 $NAME"
		echo '{"ok":true,"msg":"已开始更新订阅「'"$NAME"'」，约 10-30 秒后刷新查看结果"}'
		exit 0
		;;
	mode)
		case "$VAL" in
			"") echo '{"ok":false,"msg":"缺少模式参数"}'; exit 0 ;;
			*'"'*|*\\*) echo '{"ok":false,"msg":"非法模式"}'; exit 0 ;;
		esac
		code=$(api_put "/proxies/Proxy" "{\"name\":\"$VAL\"}")
		if [ "$code" = "204" ] || [ "$code" = "200" ]; then
			echo "{\"ok\":true,\"msg\":\"已切换到 $VAL\"}"
		elif [ "$code" = "404" ]; then
			echo '{"ok":false,"msg":"该分组不存在（订停止用后需重新生成配置）"}'
		else
			echo "{\"ok\":false,\"msg\":\"切换失败（HTTP ${code:-timeout}）\"}"
		fi
		exit 0
		;;
	secret)
		SEC=$(urldecode "$URL")
		case "$SEC" in
			""|*[!A-Za-z0-9_.-]*) echo '{"ok":false,"msg":"密钥只能用字母数字和 _ . -"}'; exit 0 ;;
		esac
		[ ${#SEC} -lt 8 ] && { echo '{"ok":false,"msg":"密钥至少 8 位"}'; exit 0; }
		printf '%s' "$SEC" > /etc/mihomo/.secret
		chmod 600 /etc/mihomo/.secret
		;;
	*)
		echo '{"ok":false,"msg":"未知操作"}'; exit 0 ;;
	esac

	# 订阅变更后重新生成配置并重启
	if [ -x "$GEN" ]; then
		out=$("$GEN" 2>&1)
		case "$out" in
			*"config OK"*)
				nohup sh -c '/etc/init.d/mihomo restart' </dev/null >/dev/null 2>&1 &
				echo '{"ok":true,"msg":"已保存，服务正在重启（约 5 秒）"}'
				;;
			*)
				detail=$(printf '%s' "$out" | tail -2 | tr '\n' ' ')
				echo "{\"ok\":false,\"msg\":\"配置校验失败：$(json_escape "$detail")\"}"
				;;
		esac
	else
		echo '{"ok":false,"msg":"缺少生成脚本 gen-config.sh"}'
	fi
	exit 0
fi

# ---------- GET ----------
# 订阅流量信息（subscription-userinfo），GET + clash UA（机场订阅常要特定 UA 才返回）
fetch_userinfo() { # $1=url -> "upload=x;download=x;total=x;expire=x" 或空
	curl -s -D - -o /dev/null -m 6 -H "User-Agent: clash.meta" -H "Accept: */*" "$1" 2>/dev/null \
		| sed -n 's/^[Ss]ubscription-[Uu]serinfo:[[:space:]]*//p' | head -1 | tr -d '\r'
}
# 字节数 -> 可读（GB/MB）
fmt_bytes() { # $1=bytes
	awk -v b="$1" 'BEGIN{if(b==""){print "";exit}
		if(b>=1073741824) printf "%.1fGB", b/1073741824;
		else if(b>=1048576) printf "%.0fMB", b/1048576;
		else printf "%.0fKB", b/1024}'
}

case "$QUERY_STRING" in
info=1)
	IP=$(uci -q get network.lan.ipaddr)
	printf '{"backend":"http://%s:9090","secret":"%s","max":%s,"count":%s}\n' \
		"${IP:-192.168.10.1}" "$(secret)" "$MAX_SUBS" "$(count_subs)"
	exit 0 ;;
proxy=1)
	if [ -f /etc/mihomo/disabled ]; then en=0; else en=1; fi
	run=0
	/etc/init.d/mihomo status 2>&1 | grep -q "^running" && run=1
	printf '{"enabled":%s,"running":%s}\n' "$en" "$run"
	exit 0 ;;
adblock=1)
	en=$(cat /etc/mihomo/adblock.enabled 2>/dev/null || echo 1)
	[ "$en" = "0" ] || en=1
	rules=/etc/mihomo/rules/anti-ad.txt
	cnt=0; upd="-"
	[ -f "$rules" ] && { cnt=$(wc -l < "$rules" 2>/dev/null || echo 0); upd=$(date -r "$rules" '+%F %H:%M' 2>/dev/null || echo -); }
	lt="-"; ls_="-"; ll=0; lsrc=""; lm=""
	if [ -f /etc/mihomo/rules/adblock.state ]; then
		IFS='|' read -r lt ls_ ll lsrc lm < /etc/mihomo/rules/adblock.state
	fi
	running=0
	ps w 2>/dev/null | grep -q "[a]dblock-update" && running=1
	cron=$(grep -h "adblock-update" /etc/crontabs/root 2>/dev/null | head -1 | sed 's/[[:space:]]*\/usr.*//')
	printf '{"enabled":%s,"count":%s,"updated":"%s","running":%s,"cron":"%s","last_time":"%s","last_status":"%s","last_lines":%s,"last_source":"%s","last_msg":"%s"}\n' \
		"$en" "$cnt" "$upd" "$running" "$(json_escape "$cron")" "$(json_escape "$lt")" "$(json_escape "$ls_")" "${ll:-0}" "$(json_escape "$lsrc")" "$(json_escape "$lm")"
	exit 0 ;;
mode=1)
	raw=$(curl -sS -m 8 -H "Authorization: Bearer $(secret)" "$API/proxies/Proxy" 2>/dev/null)
	now=$(printf '%s' "$raw" | sed -n 's/.*"now":"\([^"]*\)".*/\1/p')
	[ -z "$now" ] && now="unknown"
	groups=""
	for g in $(grep '^  - name: ' /etc/mihomo/config.yaml 2>/dev/null | sed 's/.*name: //'); do
		[ "$g" = "Proxy" ] && continue
		[ -n "$groups" ] && groups="$groups,"
		groups="$groups\"$(json_escape "$g")\""
	done
	printf '{"mode":"%s","groups":[%s]}\n' "$(json_escape "$now")" "$groups"
	exit 0 ;;
delay=1)
	raw=$(curl -sS -m 25 -H "Authorization: Bearer $(secret)" \
		"$API/group/Proxy/delay?url=http://www.gstatic.com/generate_204&timeout=3000" 2>/dev/null)
	case "$raw" in
		\{*)
			# 节点 -> 订阅归属映射（从各 sub-xxx 组的 all 构建）
			subs="{}"
			prox=$(curl -sS -m 8 -H "Authorization: Bearer $(secret)" "$API/proxies" 2>/dev/null)
			case "$prox" in
				\{*) subs=$(printf '%s' "$prox" | jq -c '[.proxies | to_entries[] | select(.key|startswith("sub-")) | .value.all[]? as $n | {key:$n, value:.key}] | from_entries' 2>/dev/null) ;;
			esac
			[ -z "$subs" ] && subs="{}"
			printf '{"ok":true,"delays":%s,"subs":%s}\n' "$raw" "$subs" ;;
		*) echo '{"ok":false,"msg":"延迟测试失败（mihomo API 无响应）"}' ;;
	esac
	exit 0 ;;
speedtest=1)
	# 测速节点（定位故障）：不切换出口，测当前出口经代理的真实吞吐 + 各机场组延迟
	SECRET=$(secret)
	cur=$(curl -sS -m 6 -H "Authorization: Bearer $SECRET" "$API/proxies/Proxy" 2>/dev/null | sed -n 's/.*"now":"\([^"]*\)".*/\1/p')
	[ -z "$cur" ] && cur="-"
	bps=0
	if [ "$cur" != "-" ]; then
		bps=$(curl -sL -x http://127.0.0.1:7890 -o /dev/null -m 16 -w '%{speed_download}' --max-time 13 'https://speed.cloudflare.com/__down?bytes=5000000' 2>/dev/null)
		[ -z "$bps" ] && bps=0
	fi
	groups=""; first=1
	for g in $(grep '^  - name: ' /etc/mihomo/config.yaml 2>/dev/null | sed 's/.*name: //' | grep '^sub-'); do
		d=$(curl -sS -m 8 -H "Authorization: Bearer $SECRET" "$API/proxies/$g/delay?timeout=3000&url=http://www.gstatic.com/generate_204" 2>/dev/null | sed -n 's/.*"delay":\([0-9]*\).*/\1/p')
		[ -z "$d" ] && d=-1
		[ "$first" -eq 0 ] && groups="$groups,"
		first=0
		groups="$groups{\"name\":\"$(json_escape "$g")\",\"delay\":$d}"
	done
	printf '{"current":"%s","bps":%s,"groups":[%s]}\n' "$(json_escape "$cur")" "$bps" "$groups"
	exit 0 ;;
speed=1*)
	# 参数：node=<节点名>（省略则用当前出口），bytes=<下载字节数>
	NODE=$(printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n 's/^node=//p' | head -1)
	NODE=$(urldecode "$NODE")
	BYTES=$(printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n 's/^bytes=//p' | head -1)
	case "$BYTES" in ''|*[!0-9]*) BYTES=3000000 ;; esac
	[ "$BYTES" -gt 20000000 ] 2>/dev/null && BYTES=20000000
	LOCK=/tmp/mihomo-speed.lock
	mkdir "$LOCK" 2>/dev/null || { echo '{"ok":false,"msg":"已有测速任务在运行"}'; exit 0; }
	trap 'rmdir "$LOCK" 2>/dev/null' EXIT

	raw=$(curl -sS -m 8 -H "Authorization: Bearer $(secret)" "$API/proxies/Proxy" 2>/dev/null)
	PREV=$(printf '%s' "$raw" | sed -n 's/.*"now":"\([^"]*\)".*/\1/p')
	[ -z "$NODE" ] && NODE="$PREV"
	[ -z "$NODE" ] && { echo '{"ok":false,"msg":"缺少节点名，且读不到当前出口"}'; exit 0; }

	CHANGED=0
	if [ -n "$PREV" ] && [ "$NODE" != "$PREV" ]; then
		code=$(api_put "/proxies/Proxy" "{\"name\":\"$(json_escape "$NODE")\"}")
		case "$code" in
			204|200) CHANGED=1; sleep 1 ;;
			*) echo "{\"ok\":false,\"msg\":\"切换节点失败（HTTP ${code:-timeout}）\"}"; exit 0 ;;
		esac
	fi

	OUT=$(curl -sS -m 30 -x http://127.0.0.1:7890 -o /dev/null \
		-w '%{size_download} %{time_total}' \
		"https://speed.cloudflare.com/__down?bytes=$BYTES" 2>/dev/null)
	if [ "$CHANGED" = "1" ] && [ -n "$PREV" ]; then
		api_put "/proxies/Proxy" "{\"name\":\"$(json_escape "$PREV")\"}" >/dev/null 2>&1
	fi

	set -- $OUT
	SIZE=${1:-0}; SECS=${2:-0}
	case "$SIZE" in ''|*[!0-9]*) SIZE=0 ;; esac
	if [ "$SIZE" -gt 0 ]; then
		MBPS=$(awk -v b="$SIZE" -v s="$SECS" 'BEGIN{ if (s>0) printf "%.1f", b*8/1000000/s; else print "0.0" }')
		printf '{"ok":true,"node":"%s","bytes":%s,"seconds":%s,"mbps":%s}\n' \
			"$(json_escape "$NODE")" "$SIZE" "$SECS" "$MBPS"
	else
		echo '{"ok":false,"msg":"测速失败（下载超时或节点不可用）"}'
	fi
	exit 0 ;;
esac

# 默认：订阅列表（含最后更新/下次更新/剩余流量/到期）
printf '['
first=1
while IFS='|' read -r n u e; do
	[ -z "$n" ] && continue
	[ -z "$e" ] && e=1
	# 最后更新：provider 缓存文件 mtime；下次更新 = mtime + 3600（gen-config interval）
	upd=""; nxt=""
	PF=/etc/mihomo/providers/$n.yaml
	if [ -f "$PF" ]; then
		ts=$(date -r "$PF" +%s 2>/dev/null)
		[ -n "$ts" ] && { upd=$(date -d "@$ts" '+%m-%d %H:%M' 2>/dev/null); nxt=$(date -d "@$((ts+3600))" '+%m-%d %H:%M' 2>/dev/null); }
	fi
	# 剩余流量 / 到期：从订阅响应头 subscription-userinfo 解析
	rem=""; exp=""
	ui=$(fetch_userinfo "$u")
	if [ -n "$ui" ]; then
		up=$(printf '%s' "$ui" | sed -n 's/.*upload=\([0-9]*\).*/\1/p')
		dl=$(printf '%s' "$ui" | sed -n 's/.*download=\([0-9]*\).*/\1/p')
		tot=$(printf '%s' "$ui" | sed -n 's/.*total=\([0-9]*\).*/\1/p')
		ex=$(printf '%s' "$ui" | sed -n 's/.*expire=\([0-9]*\).*/\1/p')
		if [ -n "$tot" ]; then
			used=$(( ${up:-0} + ${dl:-0} )); remain=$(( tot - used )); [ "$remain" -lt 0 ] && remain=0
			rem=$(fmt_bytes "$remain")
		fi
		[ -n "$ex" ] && exp=$(date -d "@$ex" '+%Y-%m-%d' 2>/dev/null)
	fi
	[ "$first" -eq 0 ] && printf ','
	first=0
	printf '{"name":"%s","url":"%s","enabled":%s,"updated":"%s","next":"%s","remain":"%s","expire":"%s"}' \
		"$(json_escape "$n")" "$(json_escape "$u")" "$e" "$(json_escape "$upd")" "$(json_escape "$nxt")" "$(json_escape "$rem")" "$(json_escape "$exp")"
done < "$SUBS"
printf ']\n'
